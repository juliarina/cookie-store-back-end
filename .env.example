# Server
NODE_ENV=development
PORT=4000
HOST=0.0.0.0

# Database (PostgreSQL)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/cookie_store?schema=public"

# Redis (cache / rate-limit / queues)
REDIS_URL="redis://localhost:6379"
REDIS_ENABLED=true

# JWT
JWT_ACCESS_SECRET="change-me-access-secret-min-32-chars-random"
JWT_REFRESH_SECRET="change-me-refresh-secret-min-32-chars-random"
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=7d

# CORS allowlist (comma separated)
CORS_ORIGINS="http://localhost:5173"

# Payment provider: "mock" (default) or "stripe" (drop-in later)
PAYMENT_PROVIDER=mock

# Rate limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100

# Logging
LOG_LEVEL=info