    {
      "name": "Orders",
      "description": "Checkout (guest and cart-based), listing, single order, admin status updates. Mock payment auto-pays, so orders are created as PAID.",
      "item": [
        {
          "name": "Checkout (guest)",
          "description": "Guest checkout sends explicit items.",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/api/v1/orders",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Guest Shopper\",\n  \"email\": \"guest@example.com\",\n  \"phone\": \"+15551234567\",\n  \"city\": \"Springfield\",\n  \"address\": \"742 Evergreen Terrace\",\n  \"items\": [\n    { \"productId\": \"{{productId}}\", \"quantity\": 1 }\n  ]\n}",
              "options": { "raw": { "language": "json" } }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 201', () => pm.response.to.have.status(201));",
                  "const json = pm.response.json();",
